# build with scb
# 
# https://github.com/sm222/SuperCBuilder


ING:
  thirdParty;
  Render;
  Ui;
  windows;

raylibPath:thirdParty/raylib/src/libraylib.a

debug:-g

engineSetting:
  -D 'HOT_RELOAD=1' 
  -Wextra -Wno-missing-field-initializers

flags:
  -Wall 
  -Werror 
  -Wextra

NAME:IceFactory
NAMEX:
  %_LINUX\ .out
  %_MACOS\ .out
  %_WINDOWS\ .exe

engineFlags:
  %_LINUX\ %raylibPath -lGL -lm -lrt -lX11
  %_MACOS\   todo
  %_WINDOWS\ todo


CFLAGS:
  %flags 
  %engineSetting 

CXXFLAGS:
  %flags 
  %engineSetting 


DEP:
  make -j10 -C thirdParty/raylib/src

PROG:
  %engineFlags
